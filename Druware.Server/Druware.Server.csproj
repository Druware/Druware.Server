<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Package Information -->
    <PackageId>Druware.Server</PackageId>
    <Version>1.1.19</Version>
    <Title>Druware.Server</Title>
    <PackageTags>net6 net8 webapi</PackageTags>
    <Description>
      This is the core Druware Server class library that implements the
      foundation logic, including utility functions, classes that are part
      of the Druware pluggable applications modules.
    </Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Druware/Druware.SErver</RepositoryUrl>
    <Authors>Dru Satori</Authors>
    <Company>dru@druware.com</Company>
    <Copyright>Copyright 2019-2026 by:
      Andy 'Dru' Satori @ Druware Software Designs.
      All Rights Reserved</Copyright>
    
  </PropertyGroup>

  <ItemGroup>
    <!-- PropertyGroup necessary references -->
    <None Include="..\CHANGE.md" Pack="false" PackagePath="CHANGE.md" />
    <None Include="..\LICENSE.txt" Pack="true" PackagePath="LICENSE.txt" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Communication.Email" Version="1.1.0" />
    <PackageReference Include="Druware.Extensions" Version="1.1.*" />
    <PackageReference Include="Microsoft.AspNetCore.Identity" Version="2.3.*" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Core" Version="2.3.*" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.*" />
    <PackageReference Include="MailKit" Version="4.17.*" />
    <!-- Pinned above the vulnerable versions dragged in transitively:
         SQLitePCLRaw.lib.e_sqlite3 2.1.6 (GHSA-2m69-gcr7-jv3q) via the bundle,
         and System.Security.Cryptography.Xml 4.5.0 (GHSA-vh55-786g-wjwj) via
         Microsoft.AspNetCore.DataProtection. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.*" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.*" />
    <!-- Pinned above the deprecated versions dragged in transitively:
         Microsoft.Data.SqlClient 5.1.x (via Microsoft.EntityFrameworkCore.SqlServer)
         pins Azure.Identity 1.11.4, Microsoft.Identity.Client 4.61.3 and the
         Microsoft.IdentityModel / System.IdentityModel.Tokens.Jwt 6.35.0 family,
         plus System.Text.Json 4.7.2 - all deprecated. 6.1.x moves them to
         Azure.Identity 1.17.x, Microsoft.Identity.Client 4.84.x and
         Microsoft.IdentityModel 7.7.x. System.Collections.Immutable 6.0.0 comes in
         via Microsoft.CodeAnalysis 4.5.0 under the EntityFrameworkCore
         Tools/Design build-time packages, so it is pinned privately - it is not
         part of this library's public dependency contract. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.*" />
    <PackageReference Include="System.Collections.Immutable" Version="8.0.*">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.*" />
    <PackageReference Include="RESTfulFoundation.Server" Version="1.0.*" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Migrations\Microsoft\" />
    <Folder Include="Migrations\PostgreSQL\" />
    <Folder Include="Migrations\Sqlite\" />
    <Folder Include="Models\" />
    <Folder Include="pub\" />
  </ItemGroup>

</Project>
